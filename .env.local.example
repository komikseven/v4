# ─── KOMIKU Environment Variables ───────────────────────────────────────────

# WordPress API (sudah dikonfigurasi di lib/api.ts, tidak perlu diubah)
# NEXT_PUBLIC_WP_API=https://komik7.my.id/wp-json/wp/v2

# ─── Redis Cache ─────────────────────────────────────────────────────────────
#
# Opsi 1: Redis lokal (untuk development)
REDIS_URL=redis://localhost:6379
#
# Opsi 2: Upstash Redis (gratis, cocok untuk Vercel/production)
# Daftar di: https://upstash.com
# REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_HOST.upstash.io:6379
#
# Opsi 3: Redis Cloud
# REDIS_URL=redis://default:password@redis-xxxxx.c1.asia-southeast1-1.gce.cloud.redislabs.com:port
#
# Jika REDIS_URL tidak diset → app tetap jalan, langsung ke WordPress API
# (tidak ada caching, lebih lambat)
